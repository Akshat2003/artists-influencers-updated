# Copy this file to ".env" for local dev, and add the same values in the
# Vercel dashboard (Project → Settings → Environment Variables) for production.
#
# IMPORTANT: .env is git-ignored. Never commit your real connection string.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=underdawg

# Instagram Graph API (business_discovery) — server-only, used to enrich entries
# with follower counts, engagement and profile metrics on add.
#   IG_USER_ID     = your IG Business/Creator account id (the API caller).
#   IG_TOKEN       = Facebook long-lived access token (EAA...). Expires ~60 days;
#                    refresh with the fb_exchange_token flow and update here +
#                    in the Vercel dashboard, then run POST /api/enrich?all=1.
#   IG_API_VERSION = optional, defaults to v21.0.
IG_USER_ID=17841441402940138
IG_TOKEN=EAA_your_facebook_long_lived_token_here
IG_API_VERSION=v21.0

# Auth — server-only.
#   SESSION_SECRET: long random string for signing session cookies (REQUIRED in prod).
#   ADMIN_USER / ADMIN_PASSWORD: the seed admin account, created on first run.
#   SERVICE_TOKEN: shared token so internal callers (backfill/cron) can hit
#                  /api/enrich without a login (x-service-token header).
SESSION_SECRET=<generate-a-long-random-string>
ADMIN_USER=admin
ADMIN_PASSWORD=<choose-a-strong-admin-password>
SERVICE_TOKEN=<generate-a-random-token>
